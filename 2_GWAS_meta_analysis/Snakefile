		"results/3_meta_analysis/SUMMARY_lambda"
	shell:
		"""
		cat {input} >> {output}
		"""
# 5. Conditional analysis
rule gcta_preprocessing:
	input:
		"results/3_meta_analysis/{protein}.meta{meta_scheme}.assoc.info.tbl"
	output:
		temporary=("results/3_meta_analysis/gcta_cojo/{protein}.meta{meta_scheme}.assoc.info.tbl.cojo")
	threads:
		2
	shell:
		"awk -F '\\t' '{{print $1 FS $2 FS $3 FS $4 FS $8 FS $9 FS $10 FS $16}}' {input} >> {output}"

rule run_gcta:
	input:
		"results/3_meta_analysis/gcta_cojo/{protein}.meta{meta_scheme}.assoc.info.tbl.cojo"
	output:
		"results/3_meta_analysis/gcta_cojo/{protein}.meta{meta_scheme}.assoc.conditional.jma.cojo"
	params:
		outfile="results/3_meta_analysis/gcta_cojo/{protein}.meta{meta_scheme}.assoc.conditional"
	threads:
		4
	shell:
		"""
		module load gcta/1.94.1
		echo 'Chr	SNP	bp	refA	freq	b	se	p	n	freq_geno	bJ	bJ_se	pJ	LD_r' > {output}
		gcta \
		--bfile autosomes \
		--remove removeBADQCand3dRELATIVESind.txt \
    	--cojo-file {input} \
    	--cojo-slct \
   		--cojo-p 5e-8 \
    	--threads {threads} \
		--out {params.outfile}
		"""
rule gcta_add_protein_name:
	input:
		"results/3_meta_analysis/gcta_cojo/{protein}.meta{meta_scheme}.assoc.conditional.jma.cojo"
	output:
		temporary("results/3_meta_analysis/gcta_cojo/{protein}.meta{meta_scheme}.assoc.conditional.jma.cojo.tmp")
	shell:
		"""
		protein_target={wildcards.protein}
		protein_name=`echo {wildcards.protein} | sed 's/.*_\(nobmi\|bmi\)_//g'`
		awk -F '\\t' -v my_var="$protein_name" 'FNR == 1 {{print $0 FS "genome_target" FS "protein_name";next}} {{print $0 FS "{wildcards.protein}" FS my_var}}' {input} > {output} 
		"""
rule gcta_summarize_conditional_data:
	input:
		expand("results/3_meta_analysis/gcta_cojo/{protein}.meta{meta_scheme}.assoc.conditional.jma.cojo.tmp", protein=config['nobmi_proteins'], meta_scheme=['.stderr'])
	output:
		"results/3_meta_analysis/gcta_cojo/CONDITIONAL.nobmi.meta.stderr.assoc.study_wide"
	shell:
		"""
		awk '/^[^Chr]/ {{print $0}}' {input} >> {output}
		"""
rule gcta_merge_clumped_TSS:
	input:
		sumstats="results/3_meta_analysis/gcta_cojo/CONDITIONAL.nobmi.meta.stderr.assoc.study_wide",
		tss="data/olink_TSS.extended.txt"
	output:
		"results/3_meta_analysis/gcta_cojo/CONDITIONAL.nobmi.meta.stderr.assoc.study_wide.tss"
	shell:
		"""
		echo 'Chr	SNP	bp	refA	freq	b	se	p	n	freq_geno	bJ	bJ_se	pJ	LD_r	gwas_target	protein_name	tss_chr	tss_position	uniprot_id' > {output}
		awk -F '\\t' 'NR==FNR{{a[$5]=$4 FS $1 FS $3;}} NR!=FNR{{print $0 FS a[$16]}}' {input.tss} {input.sumstats} | awk 'NR!=1' >> {output} 
		"""
rule gcta_add_spdi:
	input:
		"results/3_meta_analysis/gcta_cojo/CONDITIONAL.nobmi.meta.stderr.assoc.study_wide.tss"
	output:
		temporary("results/3_meta_analysis/gcta_cojo/CONDITIONAL.nobmi.meta.stderr.assoc.study_wide.tss.tmp")
	shell:
		"""
		echo 'chr	SNP	pos	refA	freq	b	se	p	n	freq_geno	bJ	bJ_se	pJ	LD_r	gwas_target	protein_name	tss_chr	tss_position	uniprot_id	spdi' > {output}
		awk -F '\\t' '{{split($2,a,":");}} (FNR != 1){{print $0 FS a[1]":"a[2]-1":"a[3]":"a[4]}}' {input} >> {output} 
		"""
rule gcta_calculate_cis_trans:
	input:
		"results/3_meta_analysis/gcta_cojo/CONDITIONAL.nobmi.meta.stderr.assoc.study_wide.tss.tmp"
